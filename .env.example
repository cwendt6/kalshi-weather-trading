# =============================================================================
# Kalshi Trading System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
# All values shown are defaults unless noted otherwise.
# =============================================================================


# =============================================================================
# Kalshi API Credentials
# =============================================================================
# Get your API key from: https://kalshi.com/settings/api
KALSHI_API_KEY=your_kalshi_api_key_uuid_here

# Private key — provide EITHER the file path OR base64-encoded key (not both)
KALSHI_PRIVATE_KEY_PATH=/path/to/your/private_key.pem
# KALSHI_PRIVATE_KEY=base64_encoded_private_key_here

# Environment: "production" for real money, "demo" for paper trading sandbox
KALSHI_ENVIRONMENT=demo


# =============================================================================
# Trading Mode
# =============================================================================
# Paper trading mode — set to "false" for live trading with real money
PAPER_TRADING=true

# Weather-only mode — restricts system to weather markets only
WEATHER_ONLY_MODE=true

# Disable crypto strategies (set by weather-only mode launcher)
# CRYPTO_ENABLED=false


# =============================================================================
# Database
# =============================================================================
# SQLAlchemy database URL (SQLite default, Postgres upgrade path available)
DATABASE_URL=sqlite:///./data/kalshi_trading.db


# =============================================================================
# Logging
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (relative to project root)
LOG_FILE=logs/trading.log


# =============================================================================
# Risk Parameters
# =============================================================================
# Max percentage of bankroll per single position (0.0 - 1.0)
MAX_POSITION_PCT=0.10

# Stop trading after this daily loss percentage (0.0 - 1.0)
MAX_DAILY_LOSS_PCT=0.05

# Max percentage of total bankroll at risk across all positions (0.0 - 1.0)
MAX_TOTAL_EXPOSURE_PCT=0.50

# Kelly Criterion fraction for position sizing (0.5 = half-Kelly, conservative)
KELLY_FRACTION=0.5

# Minimum edge required to enter a trade (paper mode: 0.02, live: 0.05)
MIN_EDGE_THRESHOLD=0.02

# Max drawdown before pausing trading (1.0 = disabled)
MAX_DRAWDOWN_PCT=1.0

# Starting bankroll for paper trading (live mode syncs from Kalshi API)
INITIAL_BANKROLL=10000.0

# Maximum trades allowed per day
MAX_DAILY_TRADES=500

# Strategy allocation: fraction of bankroll for weather strategy (0.0 - 1.0)
ALLOC_WEATHER_STRATEGY=1.0


# =============================================================================
# Scan Intervals
# =============================================================================
# Weather market scan interval in seconds
SCAN_INTERVAL_WEATHER=600

# Position check interval in seconds (exit management)
POSITION_CHECK_INTERVAL=30


# =============================================================================
# Position Management
# =============================================================================
# Enable trailing stop exits
TRAILING_STOP_ENABLED=true

# Enable take-profit ladder exits
TAKE_PROFIT_ENABLED=true

# Enable time-decay exits for stale positions
TIME_DECAY_EXIT_ENABLED=true

# Max position age in hours before forced review (default 7 days)
MAX_POSITION_AGE_HOURS=168.0


# =============================================================================
# Weather Strategy — Core Parameters
# =============================================================================
# Comma-separated list of cities to trade (leave unset for all 15 cities)
# Valid: NYC, MIAMI, AUSTIN, LOS_ANGELES, CHICAGO, DENVER, MINNEAPOLIS,
#        PHILADELPHIA, ATLANTA, HOUSTON, SEATTLE, BOSTON, DETROIT, PHOENIX, DALLAS
# WEATHER_ENABLED_CITIES=NYC,MIAMI,AUSTIN,LOS_ANGELES,CHICAGO

# Only trade daily (not monthly) weather markets
WEATHER_ONLY_DAILY=true

# Max days into the future to trade weather markets
WEATHER_MAX_DAYS_OUT=1

# Hour (UTC) after which no new weather entries are allowed
WEATHER_ENTRY_CUTOFF_HOUR=23

# Max dollar amount per weather event
WEATHER_MAX_PER_EVENT=20.0

# Max trades per weather scan cycle
WEATHER_MAX_TRADES_PER_CYCLE=10

# Max trades per city per cycle (~4 brackets per city)
WEATHER_MAX_TRADES_PER_CITY=4

# Max NO contracts per weather trade
WEATHER_NO_MAX_CONTRACTS=20

# Max YES contracts per weather trade
WEATHER_YES_MAX_CONTRACTS=15

# Minimum contract price in cents (skip very cheap contracts)
WEATHER_MIN_PRICE=5

# Max YES contract price in cents
WEATHER_YES_CEILING=25

# Max NO contract price in cents
WEATHER_NO_CEILING=65

# Max YES contracts per individual market
WEATHER_MAX_YES_PER_MARKET=2

# Max dollar exposure per weather position
WEATHER_MAX_POSITION_DOLLARS=2.00

# Use mock weather data instead of NWS API (TESTING ONLY — never for real money)
USE_MOCK_WEATHER=false

# Bracket squeeze: distance in degrees F for YES convergence signal
WEATHER_CONVERGENCE_DISTANCE=2.0

# Bracket squeeze: distance in degrees F for NO exclusion signal
WEATHER_EXCLUSION_DISTANCE=5.0

# Bracket squeeze: minimum probability for exclusion trades
WEATHER_EXCLUSION_MIN_PROB=0.80


# =============================================================================
# Weather Strategy — City Budget Allocator
# =============================================================================
# Max fraction of portfolio value to deploy per city
WEATHER_PORTFOLIO_PCT_PER_CITY=0.10

# Max fraction of available cash to deploy per city
WEATHER_CASH_PCT_PER_CITY=0.10

# Max number of cities to trade per cycle
WEATHER_MAX_CITIES_PER_CYCLE=8

# Minimum budget (dollars) to bother trading a city
WEATHER_MIN_CITY_BUDGET=0.01

# Max percentage of total budget any single city can receive
WEATHER_MAX_CITY_PCT=0.20


# =============================================================================
# Weather Strategy — Anti-Loop Detector
# =============================================================================
# Cooldown minutes after exiting a ticker before re-entry is allowed
WEATHER_ANTI_LOOP_COOLDOWN_MIN=60

# Max consecutive losses on a ticker before blocking re-entry
WEATHER_ANTI_LOOP_MAX_LOSSES=3

# Minimum edge increase required to re-enter after an exit (prevents fee-burning loops)
WEATHER_ANTI_LOOP_MIN_EDGE_INCREASE=0.05


# =============================================================================
# Phase 2: YES Exit Stages (Position Re-Evaluator)
# =============================================================================
# Stage 1: minimum price multiplier for first take-profit (e.g., 1.5x entry)
WEATHER_YES_STAGE1_MIN_MULT=1.5

# Stage 2: price multiplier for second take-profit (e.g., 3x entry)
WEATHER_YES_STAGE2_MULT=3.0

# Stage 2: fraction of position to sell at stage 2
WEATHER_YES_STAGE2_SELL_FRAC=0.50

# Stage 2: minimum edge required to hold through stage 2
WEATHER_YES_MIN_EDGE_S2=0.02

# YES take-profit tier 1: cents of profit to trigger (sell TP1_FRACTION)
WEATHER_YES_TP1_CENTS=5

# YES take-profit tier 2: cents of profit to trigger (sell TP2_FRACTION)
WEATHER_YES_TP2_CENTS=10

# YES take-profit tier 3: cents of profit to trigger (full exit)
WEATHER_YES_TP3_CENTS=15

# Fraction of position to sell at YES TP1
WEATHER_YES_TP1_FRACTION=0.25

# Fraction of position to sell at YES TP2
WEATHER_YES_TP2_FRACTION=0.50

# Hours after entry to force-exit YES positions
WEATHER_YES_HARD_EXIT_HOURS=2.0

# NO position: distance in degrees F to trim when forecast approaches bracket
WEATHER_NO_TRIM_DISTANCE_F=2.0

# Hours before force-exiting a divergent NO position (forecast vs market)
WEATHER_DIVERGENCE_TIMEOUT_HOURS=2.5

# Drop percentage triggering hard exit for weather positions
WEATHER_HARD_DROP_PCT=0.30

# Free capital threshold below which NO re-entries are blocked (0.0 - 1.0)
WEATHER_NO_FREE_CAPITAL_THRESHOLD=0.90


# =============================================================================
# Phase 3: Forecast Reshaper
# =============================================================================
# Minimum NWS forecast shift (degrees F) to trigger a reshape event
RESHAPE_MIN_SHIFT=4.0

# Max distance (degrees F) from bracket for YES convergence signal
RESHAPE_MAX_YES_DISTANCE=5.0

# Max reshape events allowed per day (prevents over-trading on forecast noise)
RESHAPE_MAX_PER_DAY=2


# =============================================================================
# Phase 4: Observation-Settled Capital Pool
# =============================================================================
# Fraction of bankroll reserved for observation-settled trades
OBS_POOL_PCT=0.15

# Fraction of obs pool to deploy per signal
OBS_POOL_DEPLOY_PCT=0.50

# Minimum dollar amount per obs-settled trade
OBS_POOL_MIN_DEPLOY=0.50

# File path for obs pool state persistence
OBS_POOL_STATE_FILE=data/obs_pool_state.json

# Observation scanner: max entry price in cents
OBS_SCANNER_MAX_ENTRY=97

# Observation scanner: minimum profit per contract in cents
OBS_SCANNER_MIN_PROFIT=1.5

# Observation scanner: minimum contracts per trade
OBS_SCANNER_MIN_CONTRACTS=3

# Observation scanner: maximum contracts per trade
OBS_SCANNER_MAX_CONTRACTS=20

# Observation scanner: max capital per trade in dollars
OBS_SCANNER_MAX_CAPITAL=10.0

# Observation scanner: scan interval in seconds
OBS_SCAN_INTERVAL=60


# =============================================================================
# Phase 5: Settlement & Alerts
# =============================================================================
# Settlement check interval in seconds
SETTLEMENT_CHECK_INTERVAL=300

# Alert webhook format override: "discord" or "slack" (auto-detected if unset)
# ALERT_WEBHOOK_FORMAT=discord

# Minimum seconds between alert messages (rate limiting)
ALERT_RATE_LIMIT_SECONDS=60


# =============================================================================
# Phase 6: NWS Persistence
# =============================================================================
# File path for NWS daily extremes cache (observed high/low temps)
NWS_EXTREMES_FILE=data/nws_daily_extremes.json


# =============================================================================
# Edge Scoring
# =============================================================================
# Time discount rate per day for edge scoring (longer = less edge)
EDGE_TIME_DISCOUNT_PER_DAY=0.10

# Max entry price in cents for standard trades
EDGE_MAX_ENTRY_CENTS=96

# Max entry price in cents for observation-settled trades
EDGE_MAX_OBS_SETTLED_CENTS=98

# Min distance in degrees F for obs-settled edge qualification
EDGE_MIN_OBS_SETTLED_DIST=2.0


# =============================================================================
# Position Re-Evaluator — General Exit Parameters
# =============================================================================
# Minimum edge to continue holding a position (below this triggers exit review)
EXIT_MIN_EDGE_TO_HOLD=0.03

# Hard stop-loss: exit if position drops this fraction of entry cost
EXIT_HARD_STOP_LOSS_PCT=0.50

# Edge decay trigger: exit if edge has decayed by this fraction
EXIT_EDGE_DECAY_TRIGGER=0.50

# Momentum retracement: exit if price retraces this fraction from peak
EXIT_MOMENTUM_RETRACEMENT_PCT=0.30

# Force-exit positions older than this many hours (unless strong edge)
EXIT_FORCE_HOURS=48

# Edge calculation cache TTL in seconds (avoids redundant API calls)
EXIT_EDGE_CACHE_TTL=120

# Minimum hold time in minutes before any exit is allowed (grace period)
EXIT_MIN_HOLD_MINUTES=10


# =============================================================================
# Velocity Scanner
# =============================================================================
# Price movement thresholds in cents per 30 minutes for velocity tiers
VELOCITY_EXPLOSIVE_CENTS=10
VELOCITY_FAST_CENTS=5
VELOCITY_MODERATE_CENTS=2

# Minimum price snapshots required to calculate velocity
VELOCITY_MIN_SNAPSHOTS=3

# Velocity scan interval in seconds
VELOCITY_SCAN_INTERVAL=120

# Max new velocity entries per scan cycle
VELOCITY_MAX_ENTRIES=20

# Min hours to expiry for velocity trades
VELOCITY_MIN_HOURS_EXPIRY=0.25

# Max hours to expiry for velocity trades
VELOCITY_MAX_HOURS_EXPIRY=72


# =============================================================================
# Resting Order Manager
# =============================================================================
# Cents to escalate (improve) resting order price on each reprice
RESTING_ORDER_ESCALATE_CENTS=2

# Minutes between automatic repricings of resting orders
RESTING_ORDER_REPRICE_MIN=10

# Max minutes to wait before canceling an unfilled resting order
RESTING_ORDER_MAX_WAIT_MIN=30

# Minutes between profit target order updates
RESTING_PROFIT_TARGET_UPDATE_MIN=10


# =============================================================================
# AI/LLM (for forecasting)
# =============================================================================
# Anthropic API key for Claude-based probability forecasting
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (alternative to Anthropic)
# OPENAI_API_KEY=your_openai_api_key_here

# Enable LLM-powered forecasting (requires ANTHROPIC_API_KEY)
USE_LLM_FORECASTER=false


# =============================================================================
# News APIs
# =============================================================================
# Finnhub API key for financial news ingestion
# FINNHUB_API_KEY=your_finnhub_key_here


# =============================================================================
# External Data Sources
# =============================================================================
# OpenWeather API key for weather data (supplements NWS)
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenWeather poll interval in seconds
POLL_INTERVAL_OPENWEATHER=1800

# Sports odds comparison API key (free at https://the-odds-api.com/, 500 req/month)
# ODDS_API_KEY=your_odds_api_key_here


# =============================================================================
# Alerts (optional)
# =============================================================================
# Discord webhook URL for trade/alert notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Slack webhook URL for trade/alert notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your_webhook_here
